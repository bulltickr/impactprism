{
  "schema_version": 1,
  "id": "python-dotenv-alias",
  "provenance": "synthetic",
  "ecosystem": "python",
  "package_manager": "pip",
  "scan": {
    "command": "impactprism scan . --ecosystem python --json",
    "expected_result": "clean",
    "expected_finding_types": []
